# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real keys.
#
# NOTE: the dashboard's odds source is Polymarket, whose public API is FREE and
# NEEDS NO KEY. Nothing below is required for normal operation. The keys here
# only feed the dormant bookmaker-odds path, kept in case a free bookmaker API
# ever carries F1 again (as of Aug 2026, neither The Odds API nor OddsPapi
# lists any Formula 1 market — both verified against live keys).

# The Odds API (https://the-odds-api.com) — dormant. Used only by
#   npm run snapshot:odds -- --source=theoddsapi
ODDS_API_KEY=

# Optional pin for The Odds API's F1 market key (auto-detected otherwise).
# Inspect candidates with: npm run odds:discover
ODDS_SPORT_KEY=

# OddsPapi (https://oddspapi.io) — currently unused: their catalogue has no F1.
ODDSPAPI_KEY=
