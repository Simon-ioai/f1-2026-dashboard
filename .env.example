# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real keys.

# REQUIRED for odds snapshots.
# Get one free (Starter plan, 500 credits/month, no card needed):
#   1. Go to https://the-odds-api.com and click "Get API Key"
#   2. Choose the free Starter plan and confirm your email
#   3. Paste the key here, and also add it on GitHub:
#      repo -> Settings -> Secrets and variables -> Actions -> New repository secret
#      Name: ODDS_API_KEY
ODDS_API_KEY=

# OPTIONAL. The F1 championship-winner market key on The Odds API.
# Leave empty to auto-detect. To see the candidates yourself, run:
#   npm run odds:discover
# On GitHub this one is a *variable*, not a secret (Settings -> Secrets and
# variables -> Actions -> Variables tab -> Name: ODDS_SPORT_KEY).
ODDS_SPORT_KEY=
